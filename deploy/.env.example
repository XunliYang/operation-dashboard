# 部署编排环境变量（docker compose 会自动读取同目录 .env；先复制为 .env 再填值）
#   cp deploy/.env.example deploy/.env

# ---- GitHub 采集凭据（必填）----
# 默认监控目标为 OpenAN 组织 13 个仓库，单轮采集约 130 请求，远超未认证
# 配额（60 请求/小时）。不注入 token 时首轮回填会在第 1 个仓库后耗尽配额，
# 其余仓库全部 403 失败。二选一：
#   单 token：
#     OD_GITHUB_TOKEN=github_pat_xxx
#   多 token 池（逗号分隔，轮转使用）：
#     OD_GITHUB_TOKENS=github_pat_aaa,github_pat_bbb
# 细粒度 PAT 需授予所采仓库的 Contents / Issues / Pull requests 读权限。
OD_GITHUB_TOKEN=

# ---- 数据库（Postgres）----
POSTGRES_USER=od
POSTGRES_PASSWORD=change_me
POSTGRES_DB=operation_dashboard

# ---- 对外端口（可选）----
# OD_HTTP_PORT=8080
# OD_SENTIMENT_PORT=8081
