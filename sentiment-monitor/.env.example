# 监控关键词（逗号分隔）
KEYWORDS=YourKeyword,AnotherKeyword

# SMTP 邮件配置（占位符，真实凭据经环境变量注入，见 configLoader.substituteEnvVars）
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password

# Firecrawl API (可选，用于网页内容提取)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# GitHub Token (可选，提高 API 限额)
GITHUB_TOKEN=your-github-token

# ---- 网关鉴权（LEOY-7 · P0-1；二选一，不配置则视为开发/测试放行）----
# Basic Auth
# SENTIMENT_AUTH_USER=admin
# SENTIMENT_AUTH_PASS=change_me
# 或 Bearer Token
# SENTIMENT_AUTH_TOKEN=change_me

# CORS 白名单（逗号分隔；生产未配置时拒绝跨域）
# SENTIMENT_CORS_ORIGINS=http://localhost:8080
