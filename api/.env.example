# API 环境变量（前缀 OD_，见 app/core/config.py）
OD_ENV=dev
OD_HOST=0.0.0.0
OD_PORT=8000

# 仅 dev 生效；生产由 nginx 同源代理，无需 CORS
OD_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# 请求限制
OD_REQUEST_TIMEOUT_SECONDS=30
OD_MAX_BODY_BYTES=2097152
OD_MAX_URL_LENGTH=2048
OD_RATE_LIMIT_PER_MINUTE=300

# ---- 舆情只读服务（sentiment-monitor，BFF 代理）----
# 容器内服务名；本地开发可指 http://localhost:3000
OD_SENTIMENT_BASE_URL=http://sentiment-monitor:3000
# 舆情服务启用凭据时（SENTIMENT_AUTH_TOKEN）在此配置同款 token
# OD_SENTIMENT_AUTH_TOKEN=
